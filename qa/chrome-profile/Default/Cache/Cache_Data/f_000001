:root {
  --ink: #171614;
  --ink-2: #24201d;
  --ink-soft: #625c55;
  --ivory: #f2ede6;
  --porcelain: #fbf9f6;
  --paper: #fffdfa;
  --taupe: #c9bdb2;
  --wine: #74383d;
  --wine-dark: #56282c;
  --brass: #9a7c51;
  --sage: #687065;
  --line: rgba(23, 22, 20, .14);
  --line-light: rgba(255, 255, 255, .16);
  --shadow: 0 28px 80px rgba(54, 42, 32, .14);
  --radius-sm: 14px;
  --radius-md: 22px;
  --radius-lg: 34px;
  --container: 1180px;
  --serif: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
  --sans: "Aptos", "Segoe UI", Arial, sans-serif;
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; overflow-x: clip; }
body {
  margin: 0;
  min-width: 320px;
  overflow-x: clip;
  color: var(--ink);
  background: var(--porcelain);
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}
body.menu-open { overflow: hidden; }
img { display: block; max-width: 100%; height: auto; }
a { color: inherit; text-decoration: none; }
button, input, textarea, select { font: inherit; }
button { color: inherit; }
address { font-style: normal; }
::selection { color: #fff; background: var(--wine); }
:focus-visible { outline: 3px solid rgba(116, 56, 61, .5); outline-offset: 4px; }
[id] { scroll-margin-top: 110px; }

.shell { width: min(calc(100% - 48px), var(--container)); margin-inline: auto; }
.section { padding: clamp(82px, 10vw, 144px) 0; }
.skip-link {
  position: fixed; z-index: 1000; top: 12px; left: 12px;
  padding: 10px 16px; color: #fff; background: var(--ink);
  transform: translateY(-160%); transition: transform .2s ease;
}
.skip-link:focus { transform: none; }

h1, h2, h3, p { margin-top: 0; }
h1, h2, h3 { text-wrap: balance; }
h1, h2 {
  margin-bottom: .45em;
  font-family: var(--serif);
  font-weight: 400;
  line-height: .98;
  letter-spacing: -.045em;
}
h1 { font-size: clamp(3.7rem, 7vw, 6.65rem); }
h2 { font-size: clamp(2.75rem, 5vw, 5rem); }
h3 { font-size: 1.28rem; line-height: 1.2; }
h1 em, h2 em { color: var(--wine); font-weight: 400; }

.eyebrow {
  display: flex; align-items: center; gap: 11px;
  margin-bottom: 26px; color: var(--wine);
  font-size: .72rem; font-weight: 700; letter-spacing: .19em; line-height: 1.4;
  text-transform: uppercase;
}
.eyebrow > span { width: 34px; height: 1px; background: currentColor; }
.eyebrow.light { color: #d9c6ab; }

.button {
  display: inline-flex; min-height: 52px; align-items: center; justify-content: center; gap: 20px;
  padding: 14px 23px; border: 1px solid var(--ink); border-radius: 100px;
  color: #fff; background: var(--ink);
  font-size: .82rem; font-weight: 700; line-height: 1; letter-spacing: .035em;
  transition: color .25s ease, background .25s ease, border-color .25s ease, transform .25s ease;
}
.button:hover { color: #fff; background: var(--wine); border-color: var(--wine); transform: translateY(-2px); }
.button-small { min-height: 44px; padding: 12px 19px; font-size: .74rem; }
.button-outline { color: var(--ink); background: transparent; }
.button-outline:hover { color: #fff; }
.button-row { display: flex; align-items: center; flex-wrap: wrap; gap: 25px; }
.text-link {
  display: inline-flex; min-height: 44px; align-items: center; gap: 13px;
  border-bottom: 1px solid var(--line); font-size: .83rem; font-weight: 700;
}
.text-link span, .service-card a span, .catalog-card a span { transition: transform .2s ease; }
.text-link:hover span, .service-card a:hover span, .catalog-card a:hover span { transform: translateX(4px); }
.light-link { color: #fff; border-color: var(--line-light); }

.site-header {
  position: fixed; z-index: 100; inset: 0 0 auto;
  height: 86px; border-bottom: 1px solid transparent;
  background: rgba(242, 237, 230, .88); backdrop-filter: blur(18px);
  transition: height .25s ease, border-color .25s ease, box-shadow .25s ease;
}
.site-header.is-scrolled { height: 74px; border-color: var(--line); box-shadow: 0 8px 30px rgba(35, 28, 23, .06); }
.header-inner { display: flex; height: 100%; align-items: center; gap: 36px; }
.brand { display: inline-flex; align-items: center; gap: 13px; flex: 0 0 auto; }
.brand-mark {
  display: grid; width: 43px; height: 43px; place-items: center;
  border: 1px solid var(--brass); border-radius: 50%;
  font-family: var(--serif); font-size: 1.12rem; letter-spacing: -.08em;
}
.brand-copy { display: flex; flex-direction: column; line-height: 1.1; }
.brand-copy strong { font-family: var(--serif); font-size: 1.03rem; font-weight: 600; letter-spacing: -.02em; }
.brand-copy small { margin-top: 5px; color: var(--ink-soft); font-size: .62rem; letter-spacing: .13em; text-transform: uppercase; }
.site-nav { display: flex; align-items: center; gap: 29px; margin-left: auto; }
.site-nav a { position: relative; padding: 10px 0; color: #46413c; font-size: .78rem; font-weight: 650; }
.site-nav a::after { position: absolute; right: 0; bottom: 5px; left: 0; height: 1px; content: ""; background: var(--wine); transform: scaleX(0); transform-origin: right; transition: transform .22s ease; }
.site-nav a:hover::after, .site-nav a[aria-current="page"]::after { transform: scaleX(1); transform-origin: left; }
.site-nav a[aria-current="page"] { color: var(--wine); }
.header-cta { margin-left: 2px; }
.menu-button { display: none; }

.home-hero {
  position: relative; min-height: 820px; padding: 150px 0 66px;
  overflow: hidden; background: var(--ivory);
}
.home-hero::before {
  position: absolute; width: 680px; height: 680px; top: 32px; right: -170px;
  border: 1px solid rgba(154, 124, 81, .22); border-radius: 50%; content: "";
}
.home-hero::after {
  position: absolute; width: 1px; height: 42%; left: calc(50% - 590px); bottom: 0;
  content: ""; background: linear-gradient(transparent, rgba(116, 56, 61, .26));
}
.hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.08fr .92fr; align-items: center; gap: 74px; }
.hero-copy { padding-top: 15px; }
.hero-copy h1 { max-width: 700px; margin-bottom: 28px; }
.hero-lead { max-width: 600px; margin-bottom: 34px; color: var(--ink-soft); font-size: clamp(1.05rem, 1.5vw, 1.22rem); line-height: 1.7; }
.credentials { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 0; margin-top: 52px; color: var(--ink-soft); font-size: .67rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
.credentials span { display: inline-flex; align-items: center; }
.credentials span:not(:last-child)::after { width: 3px; height: 3px; margin: 0 15px; border-radius: 50%; content: ""; background: var(--wine); }
.portrait-stage { position: relative; width: min(100%, 470px); justify-self: end; padding: 20px 19px 0 0; }
.portrait-stage picture { position: relative; z-index: 2; display: block; overflow: hidden; border-radius: 240px 240px var(--radius-lg) var(--radius-lg); box-shadow: var(--shadow); }
.portrait-stage img { width: 100%; aspect-ratio: 600/835; object-fit: cover; }
.profile-arc { position: absolute; z-index: 1; width: calc(100% + 12px); aspect-ratio: 1; top: -14px; right: -14px; border: 1px solid var(--brass); border-radius: 50%; }
.profile-arc::after { position: absolute; width: 12px; height: 12px; right: 22%; bottom: 3%; border: 3px solid var(--ivory); border-radius: 50%; content: ""; background: var(--wine); }
.portrait-note {
  position: absolute; z-index: 3; right: -33px; bottom: 44px;
  display: flex; width: 204px; align-items: center; gap: 14px; padding: 17px 19px;
  border: 1px solid rgba(255, 255, 255, .5); border-radius: 60px;
  color: #fff; background: rgba(23, 22, 20, .88); backdrop-filter: blur(10px);
  box-shadow: 0 18px 50px rgba(27, 21, 18, .24);
}
.portrait-note > span { font-family: var(--serif); font-size: 1.7rem; color: #d7bd92; }
.portrait-note p { margin: 0; font-size: .68rem; line-height: 1.4; letter-spacing: .06em; text-transform: uppercase; }
.reveal { animation: rise-in .8s cubic-bezier(.2,.7,.2,1) both; }
.reveal-delay { animation-delay: .13s; }
@keyframes rise-in { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }

.principles { color: #f5f0e9; background: var(--ink); }
.principles-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
.principles article { position: relative; padding: 42px 44px 43px 0; }
.principles article + article { padding-left: 44px; border-left: 1px solid var(--line-light); }
.principles h2 { margin-bottom: 9px; font-size: 1.65rem; letter-spacing: -.02em; }
.principles p { max-width: 300px; margin: 0; color: #aaa39b; font-size: .87rem; line-height: 1.6; }
.principle-line { display: block; width: 24px; height: 2px; margin-bottom: 20px; background: var(--wine); }

.services-preview { background: var(--porcelain); }
.section-heading { margin-bottom: 55px; }
.section-heading h2 { margin-bottom: 0; }
.split-heading { display: grid; grid-template-columns: 1.15fr .7fr; align-items: end; gap: 100px; }
.split-heading > p { max-width: 460px; margin: 0 0 7px; color: var(--ink-soft); }
.centered { max-width: 830px; margin-inline: auto; text-align: center; }
.centered .eyebrow { justify-content: center; }
.service-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.service-card { position: relative; min-height: 330px; padding: 39px 35px 34px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: color .25s ease, background .25s ease, transform .25s ease; }
.service-card::before { position: absolute; width: 36px; height: 36px; top: 31px; right: 31px; border: 1px solid var(--line); border-radius: 50%; content: ""; transition: border-color .25s ease; }
.service-card::after { position: absolute; width: 5px; height: 5px; top: 47px; right: 47px; border-radius: 50%; content: ""; background: var(--wine); }
.service-card.featured { background: #eee7de; }
.service-card:hover { z-index: 2; color: #fff; background: var(--wine); transform: translateY(-4px); box-shadow: var(--shadow); }
.service-card:hover::before { border-color: rgba(255,255,255,.4); }
.service-card:hover::after { background: #e5cfaa; }
.card-label { margin-bottom: 52px; color: var(--wine); font-size: .65rem; font-weight: 750; letter-spacing: .15em; text-transform: uppercase; }
.service-card:hover .card-label, .service-card:hover > p { color: rgba(255,255,255,.74); }
.service-card h3 { max-width: 240px; margin-bottom: 17px; font-family: var(--serif); font-size: 1.65rem; font-weight: 500; }
.service-card > p:not(.card-label) { min-height: 78px; margin-bottom: 26px; color: var(--ink-soft); font-size: .86rem; line-height: 1.55; transition: color .25s ease; }
.service-card a { display: inline-flex; align-items: center; gap: 10px; font-size: .72rem; font-weight: 750; letter-spacing: .05em; }
.section-action { display: flex; justify-content: center; margin-top: 44px; }

.about-preview { padding-block: 0; color: #fff; background: var(--wine-dark); }
.about-preview-grid { display: grid; grid-template-columns: .88fr 1.12fr; min-height: 610px; }
.quote-panel { position: relative; display: flex; flex-direction: column; justify-content: flex-end; padding: 80px 65px 70px 0; overflow: hidden; background: #c9b9af; }
.quote-panel::before { position: absolute; width: 380px; height: 580px; top: 85px; right: 58px; border: 1px solid rgba(255,255,255,.45); border-radius: 50% 50% 0 0; content: ""; }
.quote-panel::after { position: absolute; width: 190px; height: 190px; top: 155px; right: 105px; border-radius: 50%; content: "LT"; display: grid; place-items: center; color: rgba(255,255,255,.78); background: rgba(86, 40, 44, .88); font-family: var(--serif); font-size: 4rem; letter-spacing: -.08em; }
.quote-panel p, .quote-panel span { position: relative; z-index: 2; }
.quote-panel p { max-width: 390px; margin-bottom: 25px; color: var(--ink); font-family: var(--serif); font-size: clamp(1.55rem, 2.7vw, 2.35rem); line-height: 1.16; }
.quote-panel span { color: var(--wine-dark); font-size: .67rem; font-weight: 750; letter-spacing: .15em; text-transform: uppercase; }
.about-copy { display: flex; flex-direction: column; justify-content: center; padding: 90px 30px 90px 95px; }
.about-copy h2 { max-width: 610px; font-size: clamp(3rem, 5vw, 5.15rem); }
.about-copy > p:not(.eyebrow) { max-width: 560px; margin: 13px 0 33px; color: #d1c5bc; }
.about-copy .text-link { align-self: flex-start; }

.final-cta { position: relative; text-align: center; background: var(--ivory); overflow: hidden; }
.final-cta::before, .final-cta::after { position: absolute; border: 1px solid rgba(154,124,81,.22); border-radius: 50%; content: ""; }
.final-cta::before { width: 420px; height: 420px; top: -250px; left: -100px; }
.final-cta::after { width: 240px; height: 240px; right: -90px; bottom: -130px; }
.final-cta-inner { position: relative; z-index: 2; }
.final-cta .eyebrow { justify-content: center; }
.final-cta h2 { max-width: 900px; margin-inline: auto; }
.final-cta > div > p:not(.eyebrow) { margin-bottom: 30px; color: var(--ink-soft); }

.page-hero { padding: 178px 0 88px; border-bottom: 1px solid var(--line); background: var(--ivory); }
.page-hero-grid { display: grid; grid-template-columns: 1.2fr .36fr; align-items: end; gap: 70px; }
.page-hero-copy h1 { max-width: 930px; font-size: clamp(3.7rem, 7.3vw, 7rem); }
.page-hero-copy > p:last-child { max-width: 650px; margin: 28px 0 0; color: var(--ink-soft); font-size: 1.08rem; }
.page-hero-index { justify-self: end; min-width: 190px; padding: 26px 0 5px 29px; border-left: 1px solid var(--brass); }
.page-hero-index span { display: block; margin-bottom: 18px; color: var(--wine); font-family: var(--serif); font-size: 4.5rem; line-height: .8; letter-spacing: -.08em; }
.page-hero-index p { margin: 0; color: var(--ink-soft); font-size: .7rem; font-weight: 700; letter-spacing: .13em; line-height: 1.6; text-transform: uppercase; }
.service-index span { font-size: 3.7rem; }

.story-section { background: var(--paper); }
.story-grid { display: grid; grid-template-columns: .82fr 1.18fr; align-items: center; gap: clamp(60px, 9vw, 125px); }
.story-portrait { position: relative; width: min(100%, 470px); }
.story-portrait picture { position: relative; z-index: 2; display: block; overflow: hidden; border-radius: 240px 240px 18px 18px; box-shadow: var(--shadow); }
.story-portrait img { aspect-ratio: 600/835; object-fit: cover; }
.profile-arc.small { width: calc(100% + 22px); top: -20px; right: -21px; }
.story-copy h2 { max-width: 690px; }
.story-copy > p:not(.eyebrow) { max-width: 650px; color: var(--ink-soft); }
.signature { display: flex; flex-direction: column; margin-top: 36px; }
.signature span { color: var(--wine); font-family: var(--serif); font-size: 2rem; font-style: italic; }
.signature small { color: var(--ink-soft); font-size: .65rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
.timeline-section { background: var(--ivory); }
.timeline { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 70px; border-top: 1px solid var(--line); }
.timeline article { position: relative; padding: 47px 45px 15px 0; }
.timeline article + article { padding-left: 45px; border-left: 1px solid var(--line); }
.timeline article::before { position: absolute; width: 9px; height: 9px; top: -5px; left: 0; border: 2px solid var(--ivory); border-radius: 50%; content: ""; background: var(--wine); box-shadow: 0 0 0 1px var(--wine); }
.timeline article + article::before { left: 45px; }
.timeline span, .catalog-tag { color: var(--wine); font-size: .65rem; font-weight: 750; letter-spacing: .15em; text-transform: uppercase; }
.timeline h3 { margin: 18px 0 15px; font-family: var(--serif); font-size: 1.65rem; font-weight: 500; }
.timeline p { color: var(--ink-soft); font-size: .9rem; }
.philosophy-section { color: #fff; background: var(--wine-dark); }
.philosophy-grid { display: grid; grid-template-columns: .83fr 1.17fr; gap: 100px; }
.philosophy-grid h2 { max-width: 580px; }
.philosophy-list article { display: grid; grid-template-columns: 70px 1fr; gap: 24px; padding: 31px 0; border-top: 1px solid var(--line-light); }
.philosophy-list article:last-child { border-bottom: 1px solid var(--line-light); }
.philosophy-list > article > span { color: #d3b98e; font-family: var(--serif); font-size: 1.5rem; }
.philosophy-list h3 { margin-bottom: 8px; font-family: var(--serif); font-size: 1.55rem; font-weight: 500; }
.philosophy-list p { max-width: 520px; margin: 0; color: #cbbeb8; }
.space-section { background: var(--paper); }
.space-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 100px; }
.space-grid > div:last-child > p:not(.eyebrow) { color: var(--ink-soft); }
.space-visual { position: relative; display: flex; min-height: 460px; flex-direction: column; justify-content: center; padding: 60px; overflow: hidden; color: #fff; background: var(--ink-2); }
.space-visual span { position: relative; z-index: 2; font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
.space-visual strong { position: relative; z-index: 2; color: #e1c99f; font-family: var(--serif); font-size: clamp(4rem, 8vw, 7rem); font-style: italic; font-weight: 400; letter-spacing: -.06em; line-height: .85; }
.space-lines, .space-lines::before { position: absolute; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; content: ""; }
.space-lines { width: 390px; height: 390px; top: -100px; right: -80px; }
.space-lines::before { width: 230px; height: 230px; right: 70px; bottom: -170px; }

.specialties-hero { background: linear-gradient(115deg, var(--ivory) 0 70%, #e6ddd3 70%); }
.catalog-section { background: var(--paper); }
.catalog-heading { display: grid; grid-template-columns: 1.1fr .65fr; align-items: end; gap: 90px; margin-bottom: 60px; }
.catalog-heading h2 { max-width: 740px; margin-bottom: 0; }
.catalog-heading > p { margin-bottom: 10px; color: var(--ink-soft); }
.catalog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.catalog-card { position: relative; min-height: 315px; padding: 36px; border: 1px solid var(--line); background: var(--porcelain); transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
.catalog-card:hover { border-color: rgba(116,56,61,.55); box-shadow: 0 20px 60px rgba(53,41,33,.1); transform: translateY(-3px); }
.catalog-card::after { position: absolute; width: 50px; height: 1px; right: 0; bottom: 28px; content: ""; background: var(--brass); }
.catalog-card h3 { margin: 42px 0 17px; font-family: var(--serif); font-size: 1.85rem; font-weight: 500; }
.catalog-card p { color: var(--ink-soft); font-size: .88rem; line-height: 1.6; }
.catalog-card a { position: absolute; bottom: 30px; display: inline-flex; align-items: center; gap: 10px; font-size: .7rem; font-weight: 750; letter-spacing: .04em; }
.dental-catalog { color: #fff; background: var(--ink-2); }
.dental-catalog .catalog-heading > p { color: #aaa29a; }
.dental-catalog h2 em { color: #d2b889; }
.dental-catalog .catalog-card { border-color: var(--line-light); background: #2d2925; }
.dental-catalog .catalog-card:hover { border-color: rgba(210,184,137,.65); }
.dental-catalog .catalog-card p { color: #b8b0a8; }
.dental-catalog .catalog-tag { color: #d2b889; }
.dental-grid { grid-template-columns: repeat(6, 1fr); }
.dental-grid .catalog-card { grid-column: span 2; }
.dental-grid .catalog-card:nth-last-child(2) { grid-column: 2 / span 2; }
.process-section { background: var(--ivory); }
.process-flow { display: grid; grid-template-columns: 1fr 60px 1fr 60px 1fr; align-items: center; margin-top: 70px; }
.process-flow article { text-align: center; }
.process-flow article > span { display: grid; width: 52px; height: 52px; place-items: center; margin: 0 auto 24px; border: 1px solid var(--brass); border-radius: 50%; color: var(--wine); font-family: var(--serif); font-size: 1.35rem; }
.process-flow h3 { margin-bottom: 8px; font-family: var(--serif); font-size: 1.6rem; font-weight: 500; }
.process-flow p { max-width: 300px; margin: auto; color: var(--ink-soft); font-size: .9rem; }
.process-flow i { height: 1px; background: var(--line); }

.contact-hero { background: linear-gradient(110deg, var(--ivory), #e8ded4); }
.contact-section { background: var(--paper); }
.contact-layout { display: grid; grid-template-columns: .87fr 1.13fr; gap: 80px; align-items: stretch; }
.contact-main { padding: 24px 0; }
.contact-main h2 { font-size: clamp(3.6rem, 6vw, 5.8rem); }
.contact-intro { max-width: 540px; margin-bottom: 36px; color: var(--ink-soft); }
.whatsapp-card { display: flex; max-width: 570px; min-height: 106px; align-items: center; gap: 20px; padding: 20px 24px; border: 1px solid rgba(104,112,101,.35); background: #edf0eb; transition: transform .2s ease, box-shadow .2s ease; }
.whatsapp-card:hover { transform: translateY(-3px); box-shadow: 0 18px 50px rgba(50,61,48,.12); }
.whatsapp-icon { display: grid; width: 54px; height: 54px; place-items: center; border-radius: 50%; color: #fff; background: var(--sage); font-family: var(--serif); font-weight: 700; }
.whatsapp-card > span:nth-child(2) { display: flex; flex-direction: column; }
.whatsapp-card small, .contact-details small { color: var(--ink-soft); font-size: .64rem; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
.whatsapp-card strong { font-family: var(--serif); font-size: 1.55rem; font-weight: 500; }
.whatsapp-card i { margin-left: auto; font-style: normal; }
.contact-details { display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; margin-top: 49px; }
.contact-details article { display: grid; grid-template-columns: 36px 1fr; gap: 14px; padding: 25px 0; border-top: 1px solid var(--line); }
.contact-details article:first-child { grid-row: span 2; }
.detail-icon { color: var(--wine); font-size: 1.25rem; }
.contact-details p, .contact-details address, .contact-details a { margin: 7px 0 0; color: var(--ink-soft); font-size: .86rem; line-height: 1.55; }
.contact-details a { display: inline-block; border-bottom: 1px solid var(--line); }
.map-panel { position: relative; min-height: 620px; overflow: hidden; background: #ded7cf; box-shadow: var(--shadow); }
.map-panel iframe { display: block; width: 100%; height: 100%; min-height: 620px; filter: saturate(.4) sepia(.1); }
.map-link { position: absolute; right: 18px; bottom: 18px; display: inline-flex; min-height: 48px; align-items: center; gap: 12px; padding: 12px 17px; color: #fff; background: var(--ink); font-size: .72rem; font-weight: 700; }
.appointment-note { color: #fff; background: var(--wine-dark); }
.appointment-note-inner { display: grid; grid-template-columns: 1.05fr .65fr; align-items: end; gap: 100px; }
.appointment-note h2 { margin-bottom: 0; }
.appointment-note-inner > p { margin: 0 0 9px; color: #d0c2bb; }

.site-footer { padding: 74px 0 25px; color: #d8d1c9; background: #11110f; }
.footer-grid { display: grid; grid-template-columns: 1.5fr .5fr .65fr; gap: 80px; padding-bottom: 58px; }
.footer-brand .brand-mark { color: #e1c596; border-color: #8c734d; }
.footer-brand .brand-copy strong { color: #fff; }
.footer-brand .brand-copy small { color: #8f8982; }
.footer-note { max-width: 460px; margin: 25px 0 0; color: #77736e; font-size: .76rem; }
.footer-nav { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; font-size: .78rem; }
.footer-nav p { margin-bottom: 12px; color: #fff; font-size: .64rem; font-weight: 750; letter-spacing: .15em; text-transform: uppercase; }
.footer-nav a:hover { color: #e1c596; }
.footer-nav span { color: #77736e; }
.footer-bottom { display: flex; justify-content: space-between; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.1); color: #69655f; font-size: .67rem; }
.mobile-cta { display: none; }

@media (max-width: 1040px) {
  .header-inner { gap: 20px; }
  .site-nav { gap: 18px; }
  .header-cta { display: none; }
  .hero-grid { gap: 35px; }
  .portrait-note { right: -8px; }
  .about-copy { padding-left: 65px; }
  .dental-grid { grid-template-columns: repeat(2, 1fr); }
  .dental-grid .catalog-card, .dental-grid .catalog-card:nth-last-child(2) { grid-column: auto; }
  .contact-layout { gap: 45px; }
}

@media (max-width: 820px) {
  body { padding-bottom: 76px; }
  .shell { width: min(calc(100% - 34px), var(--container)); }
  .section { padding: 82px 0; }
  .site-header, .site-header.is-scrolled { height: 72px; }
  .brand-mark { width: 39px; height: 39px; }
  .brand-copy strong { font-size: .92rem; }
  .brand-copy small { font-size: .55rem; }
  .menu-button { position: relative; z-index: 5; display: grid; width: 46px; height: 46px; margin-left: auto; place-content: center; gap: 7px; border: 1px solid var(--line); border-radius: 50%; background: transparent; }
  .menu-button span { display: block; width: 19px; height: 1px; background: currentColor; transition: transform .2s ease; }
  .menu-button[aria-expanded="true"] span:first-child { transform: translateY(4px) rotate(45deg); }
  .menu-button[aria-expanded="true"] span:last-child { transform: translateY(-4px) rotate(-45deg); }
  .site-nav { position: fixed; z-index: 4; inset: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 8px; margin: 0; padding: 92px 32px 40px; color: #fff; background: rgba(23,22,20,.98); visibility: hidden; opacity: 0; transform: translateY(-10px); transition: opacity .22s ease, transform .22s ease, visibility .22s; }
  .site-nav[data-open="true"] { visibility: visible; opacity: 1; transform: none; }
  .site-nav a { width: 100%; padding: 10px 0; color: #fff; font-family: var(--serif); font-size: clamp(2.2rem, 11vw, 3.4rem); font-weight: 400; }
  .site-nav a[aria-current="page"] { color: #e1c596; }
  .site-nav a::after { display: none; }
  .menu-open .menu-button { color: #fff; border-color: rgba(255,255,255,.25); }
  .menu-open .brand { position: relative; z-index: 5; color: #fff; }
  .menu-open .brand-copy small { color: #a7a19a; }

  .home-hero { min-height: 0; padding: 120px 0 52px; }
  .home-hero::before { width: 430px; height: 430px; top: 37%; right: -230px; }
  .home-hero::after { display: none; }
  .hero-grid { grid-template-columns: 1fr; gap: 48px; }
  .hero-copy { padding: 0; }
  .hero-copy h1 { font-size: clamp(3.5rem, 17vw, 5.4rem); }
  .hero-lead { font-size: 1rem; }
  .button-row { align-items: stretch; flex-direction: column; gap: 13px; }
  .button-row .button { width: 100%; }
  .button-row .text-link { align-self: center; }
  .credentials { margin-top: 35px; line-height: 1.3; }
  .credentials span:not(:last-child)::after { margin: 0 9px; }
  .portrait-stage { width: min(91%, 460px); justify-self: center; padding-right: 8px; }
  .portrait-note { right: -11px; bottom: 22px; width: 184px; padding: 13px 16px; }

  .principles-grid { grid-template-columns: 1fr; }
  .principles article, .principles article + article { padding: 29px 0; border-left: 0; border-top: 1px solid var(--line-light); }
  .principles article:first-child { border-top: 0; }
  .principles p { max-width: 100%; }
  .principle-line { margin-bottom: 14px; }

  .split-heading, .catalog-heading, .appointment-note-inner { grid-template-columns: 1fr; gap: 20px; }
  .split-heading > p, .catalog-heading > p { margin: 0; }
  .service-grid, .catalog-grid, .dental-grid { grid-template-columns: 1fr; }
  .service-card { min-height: 285px; }
  .about-preview-grid { grid-template-columns: 1fr; }
  .quote-panel { min-height: 510px; padding: 50px 30px 48px; }
  .quote-panel::before { right: -60px; }
  .about-copy { padding: 76px 16px 80px; }
  .about-copy h2 { font-size: 3.5rem; }
  .final-cta h2 br { display: none; }

  .page-hero { padding: 130px 0 65px; }
  .page-hero-grid { grid-template-columns: 1fr; gap: 34px; }
  .page-hero-copy h1 { font-size: clamp(3.5rem, 16vw, 5.6rem); }
  .page-hero-index { justify-self: start; min-width: 0; padding: 0 0 0 20px; }
  .page-hero-index span { margin-bottom: 12px; font-size: 3.4rem; }
  .story-grid, .philosophy-grid, .space-grid, .contact-layout { grid-template-columns: 1fr; gap: 58px; }
  .story-portrait { width: min(90%, 460px); margin-inline: auto; }
  .timeline { grid-template-columns: 1fr; border-top: 0; }
  .timeline article, .timeline article + article { padding: 35px 0 35px 35px; border-top: 1px solid var(--line); border-left: 0; }
  .timeline article::before, .timeline article + article::before { top: 38px; left: -4px; }
  .philosophy-grid { gap: 42px; }
  .space-visual { min-height: 390px; padding: 40px 30px; }
  .specialties-hero { background: var(--ivory); }
  .catalog-card { min-height: 300px; }
  .process-flow { grid-template-columns: 1fr; gap: 28px; }
  .process-flow i { width: 1px; height: 36px; margin: auto; }
  .contact-layout { gap: 50px; }
  .contact-main { padding-top: 0; }
  .contact-details { grid-template-columns: 1fr; }
  .contact-details article:first-child { grid-row: auto; }
  .map-panel, .map-panel iframe { min-height: 470px; }
  .appointment-note-inner > p { margin-top: 15px; }

  .footer-grid { grid-template-columns: 1fr 1fr; gap: 50px 35px; }
  .footer-grid > div:first-child { grid-column: 1 / -1; }
  .footer-bottom { align-items: flex-start; flex-direction: column; gap: 7px; }
  .mobile-cta { position: fixed; z-index: 90; right: 10px; bottom: 10px; left: 10px; display: flex; min-height: 56px; align-items: center; justify-content: center; gap: 10px; padding: 14px 20px; border: 1px solid rgba(255,255,255,.16); border-radius: 100px; color: #fff; background: #315d45; box-shadow: 0 14px 40px rgba(25,48,35,.3); font-size: .8rem; font-weight: 750; letter-spacing: .02em; }
  .wa-dot { width: 8px; height: 8px; border-radius: 50%; background: #a8e7bd; box-shadow: 0 0 0 4px rgba(168,231,189,.15); }
}

@media (max-width: 460px) {
  .shell { width: min(calc(100% - 28px), var(--container)); }
  h2 { font-size: 2.75rem; }
  .brand-copy strong { max-width: 155px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hero-copy h1 { font-size: 3.48rem; }
  .portrait-note { right: -8px; width: 170px; }
  .portrait-note > span { font-size: 1.45rem; }
  .service-card, .catalog-card { padding-inline: 28px; }
  .about-copy { padding-inline: 3px; }
  .quote-panel { min-height: 470px; }
  .quote-panel::after { right: 48px; }
  .page-hero-copy h1 { font-size: 3.6rem; }
  .philosophy-list article { grid-template-columns: 47px 1fr; gap: 14px; }
  .space-visual strong { font-size: 4.2rem; }
  .whatsapp-card { padding: 17px; }
  .whatsapp-icon { width: 47px; height: 47px; }
  .whatsapp-card strong { font-size: 1.3rem; }
  .contact-main h2 { font-size: 3.4rem; }
  .map-link { right: 10px; bottom: 10px; left: 10px; justify-content: center; }
  .footer-grid { grid-template-columns: 1fr; }
  .footer-grid > div:first-child { grid-column: auto; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

@media print {
  .site-header, .mobile-cta, .menu-button, .button, .map-link { display: none !important; }
  body { padding: 0; color: #000; background: #fff; }
  .page-hero, .section { padding: 32px 0; }
}
